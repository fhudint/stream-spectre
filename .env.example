# Copy to `.env` (git-ignored) and fill in. Real environment variables win over
# this file.

# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
# Optional: without it the program starts but refuses video requests. A key saved
# from the dashboard (config.secrets.toml, readable only by you) wins over this one.
YOUTUBE_API_KEY=

# Required only if [server].bind is not a loopback address. At least 16 characters.
DASHBOARD_TOKEN=
